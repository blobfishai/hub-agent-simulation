    {
      "_meta": {
        "hubbench": {
          "hint": "write",
          "server": "hubbench",
          "shape": "benchmark control"
        }
      },
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": false,
        "title": "hubbench.submit_answer"
      },
      "description": "Record the structured decision for the current task. Every field of the task's answer contract is required; resubmission replaces earlier values.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "baseline_resolution_date": {
            "description": "Resolution date for wait_for_standard_redelivery.",
            "type": "string"
          },
          "business_need_date": {
            "description": "Documented business or clinical control date that the decision must protect (ISO date).",
            "type": "string"
          },
          "controlled_item_or_record": {
            "description": "Immutable item, lot set, or transaction record in scope.",
            "type": "string"
          },
          "controlled_resolution_date": {
            "description": "Resolution date for post_verified_adjustment.",
            "type": "string"
          },
          "decision_timing_status": {
            "description": "ON_TIME when the selected outcome is on or before the control date; otherwise LATE.",
            "enum": [
              "ON_TIME",
              "LATE"
            ],
            "type": "string"
          },
          "escalated_resolution_date": {
            "description": "Resolution date for expedite_vendor_redelivery.",
            "type": "string"
          },
          "escalation_approval_required": {
            "description": "Use 1 when an alternative is outside current authority and would need a separate approval; otherwise 0.",
            "type": "integer"
          },
          "excluded_quantity": {
            "description": "invalid, duplicate, and post-cutoff Skyfield rows quarantined by ingestion validation",
            "type": "integer"
          },
          "expedited_external_readiness": {
            "description": "Expedited readiness date independently confirmed for Skyfield's confirmed standard and expedited redelivery dates on SC-9902.",
            "type": "string"
          },
          "in_scope_delivery_days": {
            "description": "Business dates with a loaded delivery inside the control period.",
            "type": "integer"
          },
          "invalid_rows_excluded": {
            "description": "Rows across the week that failed schema validation at ingest.",
            "type": "integer"
          },
          "late_file_duplicate_rows": {
            "description": "Rows of the late file that duplicate business keys already loaded.",
            "type": "integer"
          },
          "late_file_rows": {
            "description": "Rows in the post-cutoff supplemental file, as transmitted (the header count).",
            "type": "integer"
          },
          "observed_quantity": {
            "description": "Gross observed quantity before applying the control for Monday's revenue dashboard variance against the W10 close.",
            "type": "integer"
          },
          "outcome_vs_control_days": {
            "description": "Selected outcome date minus the documented control date; positive means late.",
            "type": "integer"
          },
          "quantity_unit": {
            "description": "Unit of measure for every controlled quantity: ROW.",
            "type": "string"
          },
          "recommended_incremental_cost_usd": {
            "description": "Documented incremental spend of the selected option in USD; zero when spend is not a decision driver.",
            "type": "integer"
          },
          "recommended_option": {
            "description": "Best authorized option identifier after comparing wait_for_standard_redelivery, post_verified_adjustment, expedite_vendor_redelivery.",
            "enum": [
              "wait_for_standard_redelivery",
              "post_verified_adjustment",
              "expedite_vendor_redelivery"
            ],
            "type": "string"
          },
          "recommended_outcome_date": {
            "description": "Date produced by the selected option after applying every source constraint (ISO date).",
            "type": "string"
          },
          "source_quantity": {
            "description": "settled order rows Finance's published W10 control total requires for 2026-03-02..2026-03-06",
            "type": "integer"
          },
          "standard_external_readiness": {
            "description": "Standard readiness date independently confirmed for Skyfield's confirmed standard and expedited redelivery dates on SC-9902.",
            "type": "string"
          },
          "supported_quantity": {
            "description": "rows the certified fct_revenue_daily week-10 load can support",
            "type": "integer"
          },
          "transaction_quantity": {
            "description": "Exact quantity the primary state change may persist.",
            "type": "integer"
          }
        },
        "required": [
          "baseline_resolution_date",
          "business_need_date",
          "controlled_item_or_record",
          "controlled_resolution_date",
          "decision_timing_status",
          "escalated_resolution_date",
          "escalation_approval_required",
          "excluded_quantity",
          "expedited_external_readiness",
          "in_scope_delivery_days",
          "invalid_rows_excluded",
          "late_file_duplicate_rows",
          "late_file_rows",
          "observed_quantity",
          "outcome_vs_control_days",
          "quantity_unit",
          "recommended_incremental_cost_usd",
          "recommended_option",
          "recommended_outcome_date",
          "source_quantity",
          "standard_external_readiness",
          "supported_quantity",
          "transaction_quantity"
        ],
        "type": "object"
      },
      "name": "hubbench.submit_answer"
    }
  ]
