{
  "benchmark": "HubBench",
  "family": "researchdesk",
  "schema_version": "hubbench.tool-contract.v1",
  "servers": {
    "approvals": {
      "description": "Signed task-scoped research approvals.",
      "tools": [
        "approvals.get",
        "approvals.list"
      ]
    },
    "chat": {
      "description": "Research-team collaboration threads.",
      "tools": [
        "chat.threads.get",
        "chat.threads.list"
      ]
    },
    "drive": {
      "description": "Evidence-room documents, workbooks, exports, and provenance.",
      "tools": [
        "drive.files.export",
        "drive.files.get",
        "drive.files.list"
      ]
    },
    "hubbench": {
      "description": "Benchmark-only discovery and structured answer submission controls.",
      "tools": [
        "hubbench.context.get",
        "hubbench.submit_answer"
      ]
    },
    "knowledge": {
      "description": "Versioned internal knowledge articles and immutable revision history.",
      "tools": [
        "knowledge.articles.get",
        "knowledge.articles.search",
        "knowledge.revisions.get",
        "knowledge.revisions.list"
      ]
    },
    "messages": {
      "description": "Research-team mailbox.",
      "tools": [
        "messages.get",
        "messages.list"
      ]
    },
    "metrics": {
      "description": "Metric definitions and period snapshots with gross, excluded, and supported values.",
      "tools": [
        "metrics.definitions.get",
        "metrics.definitions.list",
        "metrics.snapshots.get",
        "metrics.snapshots.list"
      ]
    },
    "notes": {
      "description": "Stakeholder drafts that are never sent by the benchmark.",
      "tools": [
        "notes.drafts.create"
      ]
    },
    "research": {
      "description": "Published claims and evidence packets with exact source and definition contracts.",
      "tools": [
        "research.claims.create",
        "research.claims.get",
        "research.packets.create",
        "research.packets.get"
      ]
    },
    "reviews": {
      "description": "Specialist review capacity and persistent reservations with protected-slot controls.",
      "tools": [
        "reviews.reservations.create",
        "reviews.reservations.get",
        "reviews.slots.list"
      ]
    },
    "search": {
      "description": "Ranked internal search indexes; rank is never treated as authority.",
      "tools": [
        "search.indexes.list",
        "search.query"
      ]
    },
    "sources": {
      "description": "Independent source-set contracts and source records with verification state.",
      "tools": [
        "sources.records.get",
        "sources.records.list",
        "sources.sets.get"
      ]
    }
  },
