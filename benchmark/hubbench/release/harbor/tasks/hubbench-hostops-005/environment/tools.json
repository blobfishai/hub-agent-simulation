    {
      "_meta": {
        "hubbench": {
          "hint": "write",
          "server": "hubbench",
          "shape": "benchmark control"
        }
      },
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": false,
        "title": "hubbench.submit_answer"
      },
      "description": "Record the structured decision for the current task. Every field of the task's answer contract is required; resubmission replaces earlier values.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "baseline_resolution_date": {
            "description": "Resolution date for copy_supported_quantity.",
            "type": "string"
          },
          "business_need_date": {
            "description": "Documented business or clinical control date that the decision must protect (ISO date).",
            "type": "string"
          },
          "controlled_item_or_record": {
            "description": "Immutable item, lot set, or transaction record in scope.",
            "type": "string"
          },
          "controlled_resolution_date": {
            "description": "Resolution date for copy_full_dr_holdings.",
            "type": "string"
          },
          "decision_timing_status": {
            "description": "ON_TIME when the selected outcome is on or before the control date; otherwise LATE.",
            "enum": [
              "ON_TIME",
              "LATE"
            ],
            "type": "string"
          },
          "escalated_resolution_date": {
            "description": "Resolution date for retrieve_direct_with_expedite.",
            "type": "string"
          },
          "escalation_approval_required": {
            "description": "Use 1 when an alternative is outside current authority and would need a separate approval; otherwise 0.",
            "type": "integer"
          },
          "excluded_quantity": {
            "description": "Drayton segments reserved for a named ticket or past retention",
            "type": "integer"
          },
          "expedited_external_readiness": {
            "description": "Expedited readiness date independently confirmed for Coldspur's confirmed standard and expedited retrieval dates on RQ-88355.",
            "type": "string"
          },
          "first_run_window": {
            "description": "Farm window of the first replay, as RUNNER/YYYY-MM-DD/SESSION.",
            "type": "string"
          },
          "observed_quantity": {
            "description": "Gross observed quantity before applying the control for this week's two telemetry replay validations.",
            "type": "integer"
          },
          "outcome_vs_control_days": {
            "description": "Selected outcome date minus the documented control date; positive means late.",
            "type": "integer"
          },
          "payload_unit": {
            "description": "Unit of the bundle size.",
            "type": "string"
          },
          "quantity_unit": {
            "description": "Unit of measure for every controlled quantity: SEGMENT.",
            "type": "string"
          },
          "receiving_store_usable": {
            "description": "Releasable segments already at the receiving nearline store that reduce the copy.",
            "type": "integer"
          },
          "recommended_incremental_cost_usd": {
            "description": "Documented incremental spend of the selected option in USD; zero when spend is not a decision driver.",
            "type": "integer"
          },
          "recommended_option": {
            "description": "Best authorized option identifier after comparing copy_supported_quantity, copy_full_dr_holdings, retrieve_direct_with_expedite.",
            "enum": [
              "copy_supported_quantity",
              "copy_full_dr_holdings",
              "retrieve_direct_with_expedite"
            ],
            "type": "string"
          },
          "recommended_outcome_date": {
            "description": "Date produced by the selected option after applying every source constraint (ISO date).",
            "type": "string"
          },
          "replay_bundle_gb": {
            "description": "Replay bundle size per validation from the tickets.",
            "type": "integer"
          },
          "scheduled_runs": {
            "description": "Count of replay validations booked on the primary farm this week.",
            "type": "integer"
          },
          "source_quantity": {
            "description": "SIM-TELEM-40 segments required by the two 65 GB replays booked 2026-04-16 and 2026-04-17",
            "type": "integer"
          },
          "standard_external_readiness": {
            "description": "Standard readiness date independently confirmed for Coldspur's confirmed standard and expedited retrieval dates on RQ-88355.",
            "type": "string"
          },
          "supported_quantity": {
            "description": "releasable SIM-TELEM-40 segments at the Drayton DR store",
            "type": "integer"
          },
          "transaction_quantity": {
            "description": "Exact quantity the primary state change may persist.",
            "type": "integer"
          }
        },
        "required": [
          "baseline_resolution_date",
          "business_need_date",
          "controlled_item_or_record",
          "controlled_resolution_date",
          "decision_timing_status",
          "escalated_resolution_date",
          "escalation_approval_required",
          "excluded_quantity",
          "expedited_external_readiness",
          "first_run_window",
          "observed_quantity",
          "outcome_vs_control_days",
          "payload_unit",
          "quantity_unit",
          "receiving_store_usable",
          "recommended_incremental_cost_usd",
          "recommended_option",
          "recommended_outcome_date",
          "replay_bundle_gb",
          "scheduled_runs",
          "source_quantity",
          "standard_external_readiness",
          "supported_quantity",
          "transaction_quantity"
        ],
        "type": "object"
      },
      "name": "hubbench.submit_answer"
    }
  ]
