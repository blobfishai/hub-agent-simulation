    {
      "_meta": {
        "hubbench": {
          "hint": "write",
          "server": "hubbench",
          "shape": "benchmark control"
        }
      },
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": false,
        "title": "hubbench.submit_answer"
      },
      "description": "Record the structured decision for the current task. Every field of the task's answer contract is required; resubmission replaces earlier values.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "baseline_resolution_date": {
            "description": "Resolution date for order_standard_to_margin.",
            "type": "string"
          },
          "business_need_date": {
            "description": "Documented business or clinical control date that the decision must protect (ISO date).",
            "type": "string"
          },
          "certifications_invalidated": {
            "description": "Certificates invalidated by the change after applying its classification.",
            "type": "integer"
          },
          "controlled_item_or_record": {
            "description": "Immutable item, lot set, or transaction record in scope.",
            "type": "string"
          },
          "controlled_resolution_date": {
            "description": "Resolution date for use_calibration_due_lot.",
            "type": "string"
          },
          "decision_timing_status": {
            "description": "ON_TIME when the selected outcome is on or before the control date; otherwise LATE.",
            "enum": [
              "ON_TIME",
              "LATE"
            ],
            "type": "string"
          },
          "escalated_resolution_date": {
            "description": "Resolution date for expedite_fixture_build.",
            "type": "string"
          },
          "escalation_approval_required": {
            "description": "Use 1 when an alternative is outside current authority and would need a separate approval; otherwise 0.",
            "type": "integer"
          },
          "excluded_quantity": {
            "description": "lot 2260-B sets whose calibration is due 2026-05-20, inside the 14-day horizon",
            "type": "integer"
          },
          "expedited_external_readiness": {
            "description": "Expedited readiness date independently confirmed for Bramwell's confirmed standard and expedited build dates on RQ-5520.",
            "type": "string"
          },
          "first_cutin_window": {
            "description": "Release-calendar window of the first in-scope cut-in, as LINE/YYYY-MM-DD/SESSION.",
            "type": "string"
          },
          "margin_sets": {
            "description": "Spare sets the policy adds on top of the uncovered requirement.",
            "type": "integer"
          },
          "observed_quantity": {
            "description": "Gross observed quantity before applying the control for next week's harness clamp cut-ins.",
            "type": "integer"
          },
          "outcome_vs_control_days": {
            "description": "Selected outcome date minus the documented control date; positive means late.",
            "type": "integer"
          },
          "quantity_unit": {
            "description": "Unit of measure for every controlled quantity: SET.",
            "type": "string"
          },
          "rebalanced_line_stations": {
            "description": "Current station count of the rebalanced line taken from the line roster, not the old layout sheet.",
            "type": "integer"
          },
          "recommended_incremental_cost_usd": {
            "description": "Documented incremental spend of the selected option in USD; zero when spend is not a decision driver.",
            "type": "integer"
          },
          "recommended_option": {
            "description": "Best authorized option identifier after comparing order_standard_to_margin, use_calibration_due_lot, expedite_fixture_build.",
            "enum": [
              "order_standard_to_margin",
              "use_calibration_due_lot",
              "expedite_fixture_build"
            ],
            "type": "string"
          },
          "recommended_outcome_date": {
            "description": "Date produced by the selected option after applying every source constraint (ISO date).",
            "type": "string"
          },
          "scheduled_cutins": {
            "description": "Count of cut-ins booked inside the in-scope week after removing cancelled and out-of-window reservations.",
            "type": "integer"
          },
          "sets_per_station": {
            "description": "Fixture-family sets required per station.",
            "type": "integer"
          },
          "source_quantity": {
            "description": "FIX-CLMP-2260 check-gauge sets required by the four cut-ins booked 2026-05-19 to 2026-05-21 at the current station counts",
            "type": "integer"
          },
          "standard_external_readiness": {
            "description": "Standard readiness date independently confirmed for Bramwell's confirmed standard and expedited build dates on RQ-5520.",
            "type": "string"
          },
          "supported_quantity": {
            "description": "FIX-CLMP-2260 sets usable for next week's dates at the Ashgrove plant",
            "type": "integer"
          },
          "transaction_quantity": {
            "description": "Exact quantity the primary state change may persist.",
            "type": "integer"
          }
        },
        "required": [
          "baseline_resolution_date",
          "business_need_date",
          "certifications_invalidated",
          "controlled_item_or_record",
          "controlled_resolution_date",
          "decision_timing_status",
          "escalated_resolution_date",
          "escalation_approval_required",
          "excluded_quantity",
          "expedited_external_readiness",
          "first_cutin_window",
          "margin_sets",
          "observed_quantity",
          "outcome_vs_control_days",
          "quantity_unit",
          "rebalanced_line_stations",
          "recommended_incremental_cost_usd",
          "recommended_option",
          "recommended_outcome_date",
          "scheduled_cutins",
          "sets_per_station",
          "source_quantity",
          "standard_external_readiness",
          "supported_quantity",
          "transaction_quantity"
        ],
        "type": "object"
      },
      "name": "hubbench.submit_answer"
    }
  ]
