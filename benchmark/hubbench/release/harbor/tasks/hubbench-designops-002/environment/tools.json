{
  "benchmark": "HubBench",
  "family": "designops",
  "schema_version": "hubbench.tool-contract.v1",
  "servers": {
    "approvals": {
      "description": "Approval workflow records with exact scope.",
      "tools": [
        "approvals.get",
        "approvals.list"
      ]
    },
    "bom": {
      "description": "Multi-level bill of materials: assembly lines, alternates, phantoms, and where-used.",
      "tools": [
        "bom.lines.list",
        "bom.whereused.list"
      ]
    },
    "calendar": {
      "description": "Production release calendar: lines, cut-in windows with freeze and maintenance holds, cut-in reservations.",
      "tools": [
        "calendar.lines.list",
        "calendar.reservations.create",
        "calendar.reservations.get",
        "calendar.reservations.list",
        "calendar.reservations.update",
        "calendar.windows.list"
      ]
    },
    "cert": {
      "description": "Certification register: certified assembly configurations, covered component revisions, re-certification lead time and fee.",
      "tools": [
        "cert.configurations.get",
        "cert.configurations.list"
      ]
    },
    "chat": {
      "description": "Engineering change office chat threads.",
      "tools": [
        "chat.threads.get",
        "chat.threads.list"
      ]
    },
    "drive": {
      "description": "Shared drive holding procedures, registers, calendars, and exports.",
      "tools": [
        "drive.files.export",
        "drive.files.get",
        "drive.files.list"
      ]
    },
    "eco": {
      "description": "Engineering change orders: workflow state, class, affected items, effectivity release.",
      "tools": [
        "eco.affected.list",
        "eco.changes.get",
        "eco.changes.list",
        "eco.changes.update"
      ]
    },
    "hubbench": {
      "description": "Benchmark-only discovery and structured answer submission controls.",
      "tools": [
        "hubbench.context.get",
        "hubbench.submit_answer"
      ]
    },
    "messages": {
      "description": "Engineering change office mailbox.",
      "tools": [
        "messages.get",
        "messages.list"
      ]
    },
    "notes": {
      "description": "Stakeholder draft notes (never sent by the benchmark).",
      "tools": [
        "notes.drafts.create"
      ]
    },
    "plm": {
      "description": "Product lifecycle management: parts, revision lifecycle, CAD models and drawings, check-in history, engineers.",
      "tools": [
        "plm.checkins.list",
        "plm.documents.list",
        "plm.engineers.get",
        "plm.parts.get",
        "plm.parts.search",
        "plm.revisions.list"
      ]
    },
    "supplier": {
      "description": "Supplier portal: fixture-build and laboratory re-certification quotes and orders.",
      "tools": [
        "supplier.orders.create",
        "supplier.orders.get",
        "supplier.orders.list",
        "supplier.quotes.get",
        "supplier.quotes.list"
      ]
    },
    "tooling": {
      "description": "Tooling register: fixture families, lot register with calibration state, inter-plant transfers.",
      "tools": [
        "tooling.families.get",
        "tooling.inventory.list",
        "tooling.sets.list",
        "tooling.transfers.create",
        "tooling.transfers.get"
      ]
    }
  },
