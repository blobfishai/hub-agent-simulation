    {
      "_meta": {
        "hubbench": {
          "hint": "write",
          "server": "hubbench",
          "shape": "benchmark control"
        }
      },
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": false,
        "title": "hubbench.submit_answer"
      },
      "description": "Record the structured decision for the current task. Every field of the task's answer contract is required; resubmission replaces earlier values.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "accelerated_completion": {
            "description": "Outcome date for expedite_vendor_reexport.",
            "type": "string"
          },
          "backfill_minutes_per_partition": {
            "description": "Worst-case rerun minutes for one attribution partition per the run history.",
            "type": "integer"
          },
          "baseline_completion": {
            "description": "Outcome date for standard_reexport_backfill.",
            "type": "string"
          },
          "business_need_date": {
            "description": "Documented business or clinical control date that the decision must protect (ISO date).",
            "type": "string"
          },
          "coverage_item_or_resource": {
            "description": "Immutable item or resource whose requirement and eligible coverage were reconciled.",
            "type": "string"
          },
          "decision_timing_status": {
            "description": "ON_TIME when the selected outcome is on or before the control date; otherwise LATE.",
            "enum": [
              "ON_TIME",
              "LATE"
            ],
            "type": "string"
          },
          "escalated_completion": {
            "description": "Outcome date for reprocess_full_raw_archive.",
            "type": "string"
          },
          "escalation_approval_required": {
            "description": "Use 1 when an alternative is outside current authority and would need a separate approval; otherwise 0.",
            "type": "integer"
          },
          "expedited_external_readiness": {
            "description": "Expedited readiness date independently confirmed for Cormorant's confirmed standard and expedited re-export dates on CA-5519.",
            "type": "string"
          },
          "external_recovery_quantity": {
            "description": "Uncovered PARTITION_DAY that the external recovery must cover.",
            "type": "integer"
          },
          "failed_partition_date": {
            "description": "Partition whose load crashed outright and never succeeded (ISO date).",
            "type": "string"
          },
          "first_contaminated_partition": {
            "description": "Earliest partition parsed from the unannounced v3.0 schema (ISO date).",
            "type": "string"
          },
          "ineligible_coverage_quantity": {
            "description": "partitions parsed from the unannounced v3.0 schema with the consent fields dropped",
            "type": "integer"
          },
          "observed_coverage_quantity": {
            "description": "Gross observed coverage for attribution partitions still certified on the v2.3 event schema before exclusions.",
            "type": "integer"
          },
          "outcome_vs_control_days": {
            "description": "Selected outcome date minus the documented control date; positive means late.",
            "type": "integer"
          },
          "partitions_per_window": {
            "description": "Partitions one 4-hour batch window can rerun at that rate.",
            "type": "integer"
          },
          "quantity_unit": {
            "description": "Unit shared by the requirement and coverage calculations: PARTITION_DAY.",
            "type": "string"
          },
          "recommended_incremental_cost_usd": {
            "description": "Documented incremental spend of the selected option in USD; zero when spend is not a decision driver.",
            "type": "integer"
          },
          "recommended_option": {
            "description": "Best authorized option identifier after comparing standard_reexport_backfill, expedite_vendor_reexport, reprocess_full_raw_archive.",
            "enum": [
              "standard_reexport_backfill",
              "expedite_vendor_reexport",
              "reprocess_full_raw_archive"
            ],
            "type": "string"
          },
          "recommended_outcome_date": {
            "description": "Date produced by the selected option after applying every source constraint (ISO date).",
            "type": "string"
          },
          "required_quantity": {
            "description": "daily attribution partitions the trailing 2026-02-23..2026-03-06 certification window covers",
            "type": "integer"
          },
          "shortage_quantity": {
            "description": "Uncovered PARTITION_DAY after netting eligible coverage from the requirement.",
            "type": "integer"
          },
          "standard_external_readiness": {
            "description": "Standard readiness date independently confirmed for Cormorant's confirmed standard and expedited re-export dates on CA-5519.",
            "type": "string"
          },
          "usable_coverage_quantity": {
            "description": "Net eligible coverage after removing partitions parsed from the unannounced v3.0 schema with the consent fields dropped.",
            "type": "integer"
          }
        },
        "required": [
          "accelerated_completion",
          "backfill_minutes_per_partition",
          "baseline_completion",
          "business_need_date",
          "coverage_item_or_resource",
          "decision_timing_status",
          "escalated_completion",
          "escalation_approval_required",
          "expedited_external_readiness",
          "external_recovery_quantity",
          "failed_partition_date",
          "first_contaminated_partition",
          "ineligible_coverage_quantity",
          "observed_coverage_quantity",
          "outcome_vs_control_days",
          "partitions_per_window",
          "quantity_unit",
          "recommended_incremental_cost_usd",
          "recommended_option",
          "recommended_outcome_date",
          "required_quantity",
          "shortage_quantity",
          "standard_external_readiness",
          "usable_coverage_quantity"
        ],
        "type": "object"
      },
      "name": "hubbench.submit_answer"
    }
  ]
