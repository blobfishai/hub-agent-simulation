{
  "benchmark": "HubBench",
  "family": "scilab",
  "schema_version": "hubbench.tool-contract.v1",
  "servers": {
    "approvals": {
      "description": "Approval workflow records with exact scope.",
      "tools": [
        "approvals.get",
        "approvals.list"
      ]
    },
    "chat": {
      "description": "Assay-operations chat threads.",
      "tools": [
        "chat.threads.get",
        "chat.threads.list"
      ]
    },
    "drive": {
      "description": "Shared drive holding SOPs, registers, calendars, and exports.",
      "tools": [
        "drive.files.export",
        "drive.files.get",
        "drive.files.list"
      ]
    },
    "eln": {
      "description": "Electronic lab notebook: method notes and SOP references with supersession.",
      "tools": [
        "eln.notes.get",
        "eln.notes.search"
      ]
    },
    "hubbench": {
      "description": "Benchmark-only discovery and structured answer submission controls.",
      "tools": [
        "hubbench.context.get",
        "hubbench.submit_answer"
      ]
    },
    "instruments": {
      "description": "Instrument schedule: analyser roster, calibration certificates, booking-window calendar, and bookings.",
      "tools": [
        "instruments.bookings.create",
        "instruments.bookings.get",
        "instruments.bookings.list",
        "instruments.bookings.update",
        "instruments.certificates.list",
        "instruments.instruments.get",
        "instruments.instruments.list",
        "instruments.windows.list"
      ]
    },
    "inventory": {
      "description": "Reagent inventory: reagent catalog, lot register with expiry and quarantine state, and inter-site transfers.",
      "tools": [
        "inventory.balances.list",
        "inventory.lots.list",
        "inventory.reagents.get",
        "inventory.transfers.create",
        "inventory.transfers.get"
      ]
    },
    "lims": {
      "description": "Laboratory information management system: assays, scientists, sample-batch counts, protocol versions, run requests, assay runs, and QC results.",
      "tools": [
        "lims.assays.get",
        "lims.assays.search",
        "lims.batches.list",
        "lims.protocols.get",
        "lims.protocols.list",
        "lims.requests.get",
        "lims.requests.list",
        "lims.results.list",
        "lims.runs.get",
        "lims.runs.list",
        "lims.scientists.get"
      ]
    },
    "messages": {
      "description": "Assay-operations mailbox for the core facility.",
      "tools": [
        "messages.get",
        "messages.list"
      ]
    },
    "notes": {
      "description": "Stakeholder draft notes (never sent by the benchmark).",
      "tools": [
        "notes.drafts.create"
      ]
    },
    "supplier": {
      "description": "Supplier portal: shipment confirmations with lead times and cold-chain terms, and reagent orders.",
      "tools": [
        "supplier.confirmations.get",
        "supplier.confirmations.list",
        "supplier.orders.create",
        "supplier.orders.get",
        "supplier.orders.list"
      ]
    }
  },
