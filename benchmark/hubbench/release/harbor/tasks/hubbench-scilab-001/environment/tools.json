    {
      "_meta": {
        "hubbench": {
          "hint": "write",
          "server": "hubbench",
          "shape": "benchmark control"
        }
      },
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": false,
        "title": "hubbench.submit_answer"
      },
      "description": "Record the structured decision for the current task. Every field of the task's answer contract is required; resubmission replaces earlier values.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "accelerated_completion": {
            "description": "Outcome date for expedite_supplier_shipment.",
            "type": "string"
          },
          "baseline_completion": {
            "description": "Outcome date for standard_order_plan.",
            "type": "string"
          },
          "business_need_date": {
            "description": "Documented business or clinical control date that the decision must protect (ISO date).",
            "type": "string"
          },
          "control_vials_per_plate": {
            "description": "Single-use control vials each plate carries under the current protocol version.",
            "type": "integer"
          },
          "coverage_item_or_resource": {
            "description": "Immutable item or resource whose requirement and eligible coverage were reconciled.",
            "type": "string"
          },
          "decision_timing_status": {
            "description": "ON_TIME when the selected outcome is on or before the control date; otherwise LATE.",
            "enum": [
              "ON_TIME",
              "LATE"
            ],
            "type": "string"
          },
          "earliest_qualified_base_window": {
            "description": "First non-displacing analyser window on or after standard control readiness (ISO date).",
            "type": "string"
          },
          "escalated_completion": {
            "description": "Outcome date for expedite_and_run_out_of_hours.",
            "type": "string"
          },
          "escalation_approval_required": {
            "description": "Use 1 when an alternative is outside current authority and would need a separate approval; otherwise 0.",
            "type": "integer"
          },
          "expedite_completion_days_saved": {
            "description": "Days the expedited shipment saves after the window calendar is reapplied.",
            "type": "integer"
          },
          "expedited_external_readiness": {
            "description": "Expedited readiness date independently confirmed for Ostrander's confirmed standard and expedited delivery dates on SO-88214.",
            "type": "string"
          },
          "external_recovery_quantity": {
            "description": "Uncovered VIAL that the external recovery must cover.",
            "type": "integer"
          },
          "ineligible_coverage_quantity": {
            "description": "quarantined and short-dated CTRL-IL6-2L vials",
            "type": "integer"
          },
          "observed_coverage_quantity": {
            "description": "Gross observed coverage for released CTRL-IL6-2L vials at the main laboratory before exclusions.",
            "type": "integer"
          },
          "outcome_vs_control_days": {
            "description": "Selected outcome date minus the documented control date; positive means late.",
            "type": "integer"
          },
          "plates_per_unit": {
            "description": "Whole plates per run after the whole-plate rounding rule at the current protocol's samples per plate.",
            "type": "integer"
          },
          "quantity_unit": {
            "description": "Unit shared by the requirement and coverage calculations: VIAL.",
            "type": "string"
          },
          "recommended_incremental_cost_usd": {
            "description": "Documented incremental cost of the selected option in USD; zero when spend is not a decision driver.",
            "type": "integer"
          },
          "recommended_option": {
            "description": "Best authorized option identifier after comparing standard_order_plan, expedite_supplier_shipment, expedite_and_run_out_of_hours.",
            "enum": [
              "standard_order_plan",
              "expedite_supplier_shipment",
              "expedite_and_run_out_of_hours"
            ],
            "type": "string"
          },
          "recommended_outcome_date": {
            "description": "Date produced by the selected option after applying every source constraint (ISO date).",
            "type": "string"
          },
          "required_quantity": {
            "description": "single-use control vials required for the re-run and duplicate run of sponsor batch B-2611 at the current 118-sample count under protocol v3",
            "type": "integer"
          },
          "required_samples": {
            "description": "Sample count the requirement is sized at, taken from the current final batch count, not a stale intake count.",
            "type": "integer"
          },
          "sample_unit": {
            "description": "Unit of the sized sample count (SAMPLE).",
            "type": "string"
          },
          "selected_instrument_window": {
            "description": "Analyser and window used by the selected option, as INSTRUMENT/YYYY-MM-DD/SESSION.",
            "type": "string"
          },
          "shortage_quantity": {
            "description": "Uncovered VIAL after netting eligible coverage from the requirement.",
            "type": "integer"
          },
          "standard_external_readiness": {
            "description": "Standard readiness date independently confirmed for Ostrander's confirmed standard and expedited delivery dates on SO-88214.",
            "type": "string"
          },
          "units_in_scope": {
            "description": "Runs the reporting rule requires controlled before the re-run is booked.",
            "type": "integer"
          },
          "usable_coverage_quantity": {
            "description": "Net eligible coverage after removing quarantined and short-dated CTRL-IL6-2L vials.",
            "type": "integer"
          }
        },
        "required": [
          "accelerated_completion",
          "baseline_completion",
          "business_need_date",
          "control_vials_per_plate",
          "coverage_item_or_resource",
          "decision_timing_status",
          "earliest_qualified_base_window",
          "escalated_completion",
          "escalation_approval_required",
          "expedite_completion_days_saved",
          "expedited_external_readiness",
          "external_recovery_quantity",
          "ineligible_coverage_quantity",
          "observed_coverage_quantity",
          "outcome_vs_control_days",
          "plates_per_unit",
          "quantity_unit",
          "recommended_incremental_cost_usd",
          "recommended_option",
          "recommended_outcome_date",
          "required_quantity",
          "required_samples",
          "sample_unit",
          "selected_instrument_window",
          "shortage_quantity",
          "standard_external_readiness",
          "units_in_scope",
          "usable_coverage_quantity"
        ],
        "type": "object"
      },
      "name": "hubbench.submit_answer"
    }
  ]
}
