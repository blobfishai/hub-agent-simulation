  "servers": {
    "approvals": {
      "description": "Approval workflow records with exact scope.",
      "tools": [
        "approvals.get",
        "approvals.list"
      ]
    },
    "cdn": {
      "description": "CDN deploy scheduler: deploy lanes with rollback capability and the deploy-window calendar.",
      "tools": [
        "cdn.lanes.list",
        "cdn.windows.list"
      ]
    },
    "chat": {
      "description": "Web-release chat threads.",
      "tools": [
        "chat.threads.get",
        "chat.threads.list"
      ]
    },
    "checklist": {
      "description": "Release checklist: QA, accessibility, legal, and performance gates with measured values, plus gate waivers.",
      "tools": [
        "checklist.budgets.list",
        "checklist.gates.list",
        "checklist.waivers.create"
      ]
    },
    "cms": {
      "description": "Headless CMS: pages, entries with token / component / asset bindings, change requests, and scheduled releases.",
      "tools": [
        "cms.change_requests.get",
        "cms.change_requests.list",
        "cms.entries.get",
        "cms.entries.list",
        "cms.pages.get",
        "cms.pages.search",
        "cms.releases.create",
        "cms.releases.get",
        "cms.releases.list",
        "cms.releases.update"
      ]
    },
    "dam": {
      "description": "Digital asset library: assets, licence grants with territories and expiry, and vendor licence requests.",
      "tools": [
        "dam.assets.get",
        "dam.assets.list",
        "dam.licence_requests.create",
        "dam.licence_requests.get",
        "dam.licences.list"
      ]
    },
    "design": {
      "description": "Design-file index: files per page with current / superseded status and frame review states.",
      "tools": [
        "design.files.get",
        "design.files.list",
        "design.frames.list"
      ]
    },
    "drive": {
      "description": "Shared drive holding the playbook, registers, calendars, and exports.",
      "tools": [
        "drive.files.export",
        "drive.files.get",
        "drive.files.list"
      ]
    },
    "hubbench": {
      "description": "Benchmark-only discovery and structured answer submission controls.",
      "tools": [
        "hubbench.context.get",
        "hubbench.submit_answer"
      ]
    },
    "messages": {
      "description": "Web-studio mailbox for the release team.",
      "tools": [
        "messages.get",
        "messages.list"
      ]
    },
    "notes": {
      "description": "Stakeholder draft notes (never sent by the benchmark).",
      "tools": [
        "notes.drafts.create"
      ]
    },
    "tokens": {
      "description": "Design-token and component registry: token versions with breaking flags, components with allowed variants and deprecations, consumer registry, and version pins.",
      "tools": [
        "tokens.components.get",
        "tokens.components.list",
        "tokens.consumers.list",
        "tokens.pins.create",
        "tokens.pins.get",
        "tokens.tokens.get",
        "tokens.versions.list"
      ]
    },
    "vendors": {
      "description": "Vendor desk: foundry and stock-imagery licence quotes, agency delivery quotes, and edge-provider lane re-certification quotes.",
      "tools": [
        "vendors.quotes.get",
        "vendors.quotes.list"
      ]
    }
  },
