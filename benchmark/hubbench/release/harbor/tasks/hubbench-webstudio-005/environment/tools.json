    {
      "_meta": {
        "hubbench": {
          "hint": "write",
          "server": "hubbench",
          "shape": "benchmark control"
        }
      },
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": false,
        "title": "hubbench.submit_answer"
      },
      "description": "Record the structured decision for the current task. Every field of the task's answer contract is required; resubmission replaces earlier values.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "baseline_resolution_date": {
            "description": "Resolution date for pin_active_consumers_and_ship.",
            "type": "string"
          },
          "business_need_date": {
            "description": "Documented business or clinical control date that the decision must protect (ISO date).",
            "type": "string"
          },
          "controlled_item_or_record": {
            "description": "Immutable item, lot set, or transaction record in scope.",
            "type": "string"
          },
          "controlled_resolution_date": {
            "description": "Resolution date for full_wave_after_standard_migration.",
            "type": "string"
          },
          "decision_timing_status": {
            "description": "ON_TIME when the selected outcome is on or before the control date; otherwise LATE.",
            "enum": [
              "ON_TIME",
              "LATE"
            ],
            "type": "string"
          },
          "deprecated_consumers": {
            "description": "Registry consumers recorded as DEPRECATED and excluded from the count.",
            "type": "integer"
          },
          "escalated_resolution_date": {
            "description": "Resolution date for agency_rush_migration_full_wave.",
            "type": "string"
          },
          "escalation_approval_required": {
            "description": "Use 1 when an alternative is outside current authority and would need a separate approval; otherwise 0.",
            "type": "integer"
          },
          "excluded_quantity": {
            "description": "consumers that are on the homepage itself, deprecated, or already migrated",
            "type": "integer"
          },
          "expedited_external_readiness": {
            "description": "Expedited readiness date independently confirmed for Orchidworks' confirmed standard and rush migration delivery dates on ORQ-2210.",
            "type": "string"
          },
          "first_release_window": {
            "description": "Deploy window of the scheduled homepage release, as LANE/YYYY-MM-DD/SESSION.",
            "type": "string"
          },
          "migrated_consumers": {
            "description": "Registry consumers already recorded as MIGRATED to the proposed version.",
            "type": "integer"
          },
          "observed_quantity": {
            "description": "Gross observed quantity before applying the control for the homepage accent ramp change.",
            "type": "integer"
          },
          "on_page_consumers": {
            "description": "Registry consumers on the change request's own page; they take the new version and are not pinned.",
            "type": "integer"
          },
          "outcome_vs_control_days": {
            "description": "Selected outcome date minus the documented control date; positive means late.",
            "type": "integer"
          },
          "quantity_unit": {
            "description": "Unit of measure for every controlled quantity: CONSUMER.",
            "type": "string"
          },
          "recommended_incremental_cost_usd": {
            "description": "Documented incremental spend of the selected option in USD; zero when spend is not a decision driver.",
            "type": "integer"
          },
          "recommended_option": {
            "description": "Best authorized option identifier after comparing pin_active_consumers_and_ship, full_wave_after_standard_migration, agency_rush_migration_full_wave.",
            "enum": [
              "pin_active_consumers_and_ship",
              "full_wave_after_standard_migration",
              "agency_rush_migration_full_wave"
            ],
            "type": "string"
          },
          "recommended_outcome_date": {
            "description": "Date produced by the selected option after applying every source constraint (ISO date).",
            "type": "string"
          },
          "source_quantity": {
            "description": "consumers of TOK-COLOR-ACCENT-500 that the v3.0 change reaches per the change request's impact panel",
            "type": "integer"
          },
          "standard_external_readiness": {
            "description": "Standard readiness date independently confirmed for Orchidworks' confirmed standard and rush migration delivery dates on ORQ-2210.",
            "type": "string"
          },
          "supported_quantity": {
            "description": "active off-page consumers that the pin must hold on v2.4",
            "type": "integer"
          },
          "token_current_version": {
            "description": "Version of the token currently published in the registry (the version the pin holds).",
            "type": "string"
          },
          "token_proposed_version": {
            "description": "Proposed breaking version the change ships on the homepage surfaces.",
            "type": "string"
          },
          "transaction_quantity": {
            "description": "Exact quantity the primary state change may persist.",
            "type": "integer"
          }
        },
        "required": [
          "baseline_resolution_date",
          "business_need_date",
          "controlled_item_or_record",
          "controlled_resolution_date",
          "decision_timing_status",
          "deprecated_consumers",
          "escalated_resolution_date",
          "escalation_approval_required",
          "excluded_quantity",
          "expedited_external_readiness",
          "first_release_window",
          "migrated_consumers",
          "observed_quantity",
          "on_page_consumers",
          "outcome_vs_control_days",
          "quantity_unit",
          "recommended_incremental_cost_usd",
          "recommended_option",
          "recommended_outcome_date",
          "source_quantity",
          "standard_external_readiness",
          "supported_quantity",
          "token_current_version",
          "token_proposed_version",
          "transaction_quantity"
        ],
        "type": "object"
      },
      "name": "hubbench.submit_answer"
    }
  ]
}
