    {
      "_meta": {
        "hubbench": {
          "hint": "write",
          "server": "hubbench",
          "shape": "benchmark control"
        }
      },
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": false,
        "title": "hubbench.submit_answer"
      },
      "description": "Record the structured decision for the current task. Every field of the task's answer contract is required; resubmission replaces earlier values.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "affected_resource_or_operation": {
            "description": "Immutable appointment, order, or resource record in the recovery scope.",
            "type": "string"
          },
          "base_completion": {
            "description": "Completion under book_first_nondisplacing_full_day.",
            "type": "string"
          },
          "business_need_date": {
            "description": "Documented business or clinical control date that the decision must protect (ISO date).",
            "type": "string"
          },
          "candidate_capacity": {
            "description": "Gross candidate capacity associated with chair-hours on first-dose-capable chairs (CHAIR-1, CHAIR-2) on the requested Thursday 2026-03-12 before protected or unavailable load is removed.",
            "type": "integer"
          },
          "capacity_gap": {
            "description": "Uncovered CHAIR_HOUR after applying finite availability inside the requested window.",
            "type": "integer"
          },
          "capacity_unit": {
            "description": "Capacity unit used throughout the schedule comparison: CHAIR_HOUR.",
            "type": "string"
          },
          "decision_timing_status": {
            "description": "ON_TIME when the selected outcome is on or before the control date; otherwise LATE.",
            "enum": [
              "ON_TIME",
              "LATE"
            ],
            "type": "string"
          },
          "drug_vials_required": {
            "description": "Whole RITUX-500 vials the 1000 mg day-1 dose needs.",
            "type": "integer"
          },
          "drug_vials_usable": {
            "description": "Dispensable RITUX-500 vials on hand after excluding short-dated stock.",
            "type": "integer"
          },
          "escalated_completion": {
            "description": "Completion under extend_thursday_with_overtime_nursing.",
            "type": "string"
          },
          "escalation_approval_required": {
            "description": "Use 1 when an alternative is outside current authority and would need a separate approval; otherwise 0.",
            "type": "integer"
          },
          "expedited_external_readiness": {
            "description": "Expedited readiness date independently confirmed for Cascadia's confirmed day-15 restock dates on Q-77901.",
            "type": "string"
          },
          "net_usable_capacity": {
            "description": "Candidate capacity remaining after removing Thursday chair-hours already booked or held as protected oncology blocks.",
            "type": "integer"
          },
          "outcome_vs_control_days": {
            "description": "Selected outcome date minus the documented control date; positive means late.",
            "type": "integer"
          },
          "qualified_alternative_completion": {
            "description": "Completion under split_infusion_across_two_sessions.",
            "type": "string"
          },
          "recommended_incremental_cost_usd": {
            "description": "Documented incremental cost of the selected option in USD; zero when spend is not a decision driver.",
            "type": "integer"
          },
          "recommended_option": {
            "description": "Best authorized option identifier after comparing book_first_nondisplacing_full_day, split_infusion_across_two_sessions, extend_thursday_with_overtime_nursing.",
            "enum": [
              "book_first_nondisplacing_full_day",
              "split_infusion_across_two_sessions",
              "extend_thursday_with_overtime_nursing"
            ],
            "type": "string"
          },
          "recommended_outcome_date": {
            "description": "Date produced by the selected option after applying every source constraint (ISO date).",
            "type": "string"
          },
          "requested_day": {
            "description": "The day the prescriber asked for (ISO date), tested against capacity before being replaced.",
            "type": "string"
          },
          "required_capacity": {
            "description": "chair-hours for one continuous first-dose rituximab infusion (360 min infusion + 60 min observation)",
            "type": "integer"
          },
          "selected_resource_or_control": {
            "description": "Provider identifier of the qualified resource and session used by the selected recovery.",
            "type": "string"
          },
          "sessions_required": {
            "description": "Chair sessions one continuous 7-hour infusion occupies on one chair-day.",
            "type": "integer"
          },
          "standard_external_readiness": {
            "description": "Standard readiness date independently confirmed for Cascadia's confirmed day-15 restock dates on Q-77901.",
            "type": "string"
          },
          "unavailable_or_protected_capacity": {
            "description": "Thursday chair-hours already booked or held as protected oncology blocks",
            "type": "integer"
          }
        },
        "required": [
          "affected_resource_or_operation",
          "base_completion",
          "business_need_date",
          "candidate_capacity",
          "capacity_gap",
          "capacity_unit",
          "decision_timing_status",
          "drug_vials_required",
          "drug_vials_usable",
          "escalated_completion",
          "escalation_approval_required",
          "expedited_external_readiness",
          "net_usable_capacity",
          "outcome_vs_control_days",
          "qualified_alternative_completion",
          "recommended_incremental_cost_usd",
          "recommended_option",
          "recommended_outcome_date",
          "requested_day",
          "required_capacity",
          "selected_resource_or_control",
          "sessions_required",
          "standard_external_readiness",
          "unavailable_or_protected_capacity"
        ],
        "type": "object"
      },
      "name": "hubbench.submit_answer"
    }
