    {
      "_meta": {
        "hubbench": {
          "hint": "write",
          "server": "hubbench",
          "shape": "benchmark control"
        }
      },
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": false,
        "title": "hubbench.submit_answer"
      },
      "description": "Record the structured decision for the current task. Every field of the task's answer contract is required; resubmission replaces earlier values.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "affected_releases": {
            "description": "Releases stranded on the fenced lane inside the privacy windows.",
            "type": "integer"
          },
          "affected_resource_or_operation": {
            "description": "Immutable appointment, order, or resource record in the recovery scope.",
            "type": "string"
          },
          "base_completion": {
            "description": "Completion under rehome_series_to_open_windows.",
            "type": "string"
          },
          "business_need_date": {
            "description": "Documented business or clinical control date that the decision must protect (ISO date).",
            "type": "string"
          },
          "candidate_capacity": {
            "description": "Gross candidate capacity associated with lane-hours on LANE-WEB-2 and LANE-EDGE-3 between 2026-05-12 and 2026-05-15 before protected or unavailable load is removed.",
            "type": "integer"
          },
          "capacity_gap": {
            "description": "Uncovered LANE_HOUR after applying finite availability inside the requested window.",
            "type": "integer"
          },
          "capacity_unit": {
            "description": "Capacity unit used throughout the schedule comparison: LANE_HOUR.",
            "type": "string"
          },
          "decision_timing_status": {
            "description": "ON_TIME when the selected outcome is on or before the control date; otherwise LATE.",
            "enum": [
              "ON_TIME",
              "LATE"
            ],
            "type": "string"
          },
          "escalated_completion": {
            "description": "Completion under displace_blackout_window.",
            "type": "string"
          },
          "escalation_approval_required": {
            "description": "Use 1 when an alternative is outside current authority and would need a separate approval; otherwise 0.",
            "type": "integer"
          },
          "expedited_external_readiness": {
            "description": "Expedited readiness date independently confirmed for Meridian Edge's confirmed standard and priority re-certification dates on MEQ-7701.",
            "type": "string"
          },
          "net_usable_capacity": {
            "description": "Candidate capacity remaining after removing lane-hours already booked, held as protected blackout or freeze blocks, or blocked for maintenance.",
            "type": "integer"
          },
          "outcome_vs_control_days": {
            "description": "Selected outcome date minus the documented control date; positive means late.",
            "type": "integer"
          },
          "protected_windows_in_week": {
            "description": "Protected (blackout or freeze) windows on the active lanes between 2026-05-12 and 2026-05-15.",
            "type": "integer"
          },
          "qualified_alternative_completion": {
            "description": "Completion under wait_for_lane_1_return.",
            "type": "string"
          },
          "recommended_incremental_cost_usd": {
            "description": "Documented incremental cost of the selected option in USD; zero when spend is not a decision driver.",
            "type": "integer"
          },
          "recommended_option": {
            "description": "Best authorized option identifier after comparing rehome_series_to_open_windows, wait_for_lane_1_return, displace_blackout_window.",
            "enum": [
              "rehome_series_to_open_windows",
              "wait_for_lane_1_return",
              "displace_blackout_window"
            ],
            "type": "string"
          },
          "recommended_outcome_date": {
            "description": "Date produced by the selected option after applying every source constraint (ISO date).",
            "type": "string"
          },
          "releases_per_window": {
            "description": "Content releases the playbook allows back to back in one 4-hour window.",
            "type": "integer"
          },
          "required_capacity": {
            "description": "lane-hours for four 2-hour content releases (60 min deploy + 60 min verification each)",
            "type": "integer"
          },
          "selected_resource_or_control": {
            "description": "Provider identifier of the qualified resource and session used by the selected recovery.",
            "type": "string"
          },
          "standard_external_readiness": {
            "description": "Standard readiness date independently confirmed for Meridian Edge's confirmed standard and priority re-certification dates on MEQ-7701.",
            "type": "string"
          },
          "stranded_lane": {
            "description": "Lane identifier fenced by the failed edge-config validation.",
            "type": "string"
          },
          "unavailable_or_protected_capacity": {
            "description": "lane-hours already booked, held as protected blackout or freeze blocks, or blocked for maintenance",
            "type": "integer"
          },
          "windows_required": {
            "description": "Free windows the four releases need when two are sequenced per window.",
            "type": "integer"
          }
        },
        "required": [
          "affected_releases",
          "affected_resource_or_operation",
          "base_completion",
          "business_need_date",
          "candidate_capacity",
          "capacity_gap",
          "capacity_unit",
          "decision_timing_status",
          "escalated_completion",
          "escalation_approval_required",
          "expedited_external_readiness",
          "net_usable_capacity",
          "outcome_vs_control_days",
          "protected_windows_in_week",
          "qualified_alternative_completion",
          "recommended_incremental_cost_usd",
          "recommended_option",
          "recommended_outcome_date",
          "releases_per_window",
          "required_capacity",
          "selected_resource_or_control",
          "standard_external_readiness",
          "stranded_lane",
          "unavailable_or_protected_capacity",
          "windows_required"
        ],
        "type": "object"
      },
      "name": "hubbench.submit_answer"
    }
  ]
}
