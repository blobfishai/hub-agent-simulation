    {
      "_meta": {
        "hubbench": {
          "hint": "write",
          "server": "hubbench",
          "shape": "benchmark control"
        }
      },
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": false,
        "title": "hubbench.submit_answer"
      },
      "description": "Record the structured decision for the current task. Every field of the task's answer contract is required; resubmission replaces earlier values.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "accelerated_completion": {
            "description": "Outcome date for expedite_and_grant_direct.",
            "type": "string"
          },
          "approved_now_count": {
            "description": "Attested readers eligible for the exception path now.",
            "type": "integer"
          },
          "baseline_completion": {
            "description": "Outcome date for exception_for_blocked_cohort.",
            "type": "string"
          },
          "binding_policy_clause": {
            "description": "The operative clause cited to refuse the out-of-scope export ask.",
            "type": "string"
          },
          "business_need_date": {
            "description": "Documented business or clinical control date that the decision must protect (ISO date).",
            "type": "string"
          },
          "cost_of_delay_usd": {
            "description": "Incremental cost of the expedited-and-direct escalation path.",
            "type": "integer"
          },
          "coverage_item_or_resource": {
            "description": "Immutable item or resource whose requirement and eligible coverage were reconciled.",
            "type": "string"
          },
          "decision_timing_status": {
            "description": "ON_TIME when the selected outcome is on or before the control date; otherwise LATE.",
            "enum": [
              "ON_TIME",
              "LATE"
            ],
            "type": "string"
          },
          "duplicate_request_count": {
            "description": "Requests consolidated to an earlier request (including a withdrawn resubmission).",
            "type": "integer"
          },
          "escalated_completion": {
            "description": "Outcome date for grant_export_bundle.",
            "type": "string"
          },
          "escalation_approval_required": {
            "description": "Use 1 when an alternative is outside current authority and would need a separate approval; otherwise 0.",
            "type": "integer"
          },
          "exception_required_count": {
            "description": "Readers blocked on a lapsed or expiring attestation, recoverable via screening.",
            "type": "integer"
          },
          "expedited_external_readiness": {
            "description": "Expedited readiness date independently confirmed for Attesta's confirmed standard and expedited data-handling clearance dates on RQ-54001.",
            "type": "string"
          },
          "external_recovery_quantity": {
            "description": "Uncovered REQUEST that the external recovery must cover.",
            "type": "integer"
          },
          "ineligible_coverage_quantity": {
            "description": "reader requests blocked on a lapsed or expiring attestation or a refused ask",
            "type": "integer"
          },
          "observed_coverage_quantity": {
            "description": "Gross observed coverage for reader requests that already hold the attestation for the exception path under the open finding before exclusions.",
            "type": "integer"
          },
          "outcome_vs_control_days": {
            "description": "Selected outcome date minus the documented control date; positive means late.",
            "type": "integer"
          },
          "quantity_unit": {
            "description": "Unit shared by the requirement and coverage calculations: REQUEST.",
            "type": "string"
          },
          "recommended_incremental_cost_usd": {
            "description": "Documented incremental cost of the selected option in USD; zero when spend is not a decision driver.",
            "type": "integer"
          },
          "recommended_option": {
            "description": "Best authorized option identifier after comparing exception_for_blocked_cohort, expedite_and_grant_direct, grant_export_bundle.",
            "enum": [
              "exception_for_blocked_cohort",
              "expedite_and_grant_direct",
              "grant_export_bundle"
            ],
            "type": "string"
          },
          "recommended_outcome_date": {
            "description": "Date produced by the selected option after applying every source constraint (ISO date).",
            "type": "string"
          },
          "refused_outright_count": {
            "description": "Requests refused outright (no attestation and out-of-scope export ask).",
            "type": "integer"
          },
          "required_quantity": {
            "description": "reader requests that need a coverage decision after removing the refusal (approve-basis plus exception-eligible)",
            "type": "integer"
          },
          "shortage_quantity": {
            "description": "Uncovered REQUEST after netting eligible coverage from the requirement.",
            "type": "integer"
          },
          "standard_external_readiness": {
            "description": "Standard readiness date independently confirmed for Attesta's confirmed standard and expedited data-handling clearance dates on RQ-54001.",
            "type": "string"
          },
          "time_boxed_grant_days": {
            "description": "Time box the operative confidential clause allows.",
            "type": "integer"
          },
          "usable_coverage_quantity": {
            "description": "Net eligible coverage after removing reader requests blocked on a lapsed or expiring attestation or a refused ask.",
            "type": "integer"
          }
        },
        "required": [
          "accelerated_completion",
          "approved_now_count",
          "baseline_completion",
          "binding_policy_clause",
          "business_need_date",
          "cost_of_delay_usd",
          "coverage_item_or_resource",
          "decision_timing_status",
          "duplicate_request_count",
          "escalated_completion",
          "escalation_approval_required",
          "exception_required_count",
          "expedited_external_readiness",
          "external_recovery_quantity",
          "ineligible_coverage_quantity",
          "observed_coverage_quantity",
          "outcome_vs_control_days",
          "quantity_unit",
          "recommended_incremental_cost_usd",
          "recommended_option",
          "recommended_outcome_date",
          "refused_outright_count",
          "required_quantity",
          "shortage_quantity",
          "standard_external_readiness",
          "time_boxed_grant_days",
          "usable_coverage_quantity"
        ],
        "type": "object"
      },
      "name": "hubbench.submit_answer"
    }
  ]
