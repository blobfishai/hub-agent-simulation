        "approvals.get",
        "approvals.list"
      ]
    },
    "audit": {
      "description": "Audit-finding tracker with grant-blocking findings.",
      "tools": [
        "audit.findings.get",
        "audit.findings.list"
      ]
    },
    "chat": {
      "description": "Access-governance team chat threads.",
      "tools": [
        "chat.threads.get",
        "chat.threads.list"
      ]
    },
    "directory": {
      "description": "Identity directory and approver directory with authority tiers and availability.",
      "tools": [
        "directory.approvers.get",
        "directory.approvers.list",
        "directory.people.get"
      ]
    },
    "drive": {
      "description": "Shared drive holding policies, registers, calendars, and exports.",
      "tools": [
        "drive.files.export",
        "drive.files.get",
        "drive.files.list"
      ]
    },
    "exceptions": {
      "description": "Exceptions register with compensating controls, approver tiers, and expiry.",
      "tools": [
        "exceptions.create",
        "exceptions.get",
        "exceptions.list"
      ]
    },
    "grants": {
      "description": "Entitlement grant store with segregation-of-duties rules, covered counts, and expiry.",
      "tools": [
        "grants.create",
        "grants.get",
        "grants.list",
        "grants.sod.check"
      ]
    },
    "hubbench": {
      "description": "Benchmark-only discovery and structured answer submission controls.",
      "tools": [
        "hubbench.context.get",
        "hubbench.submit_answer"
      ]
    },
    "messages": {
      "description": "Access-governance mailbox.",
      "tools": [
        "messages.get",
        "messages.list"
      ]
    },
    "notes": {
      "description": "Stakeholder draft notes (never sent by the benchmark).",
      "tools": [
        "notes.drafts.create"
      ]
    },
    "policy": {
      "description": "Policy library: access-governance standards with numbered clauses, versions, and effective dates.",
      "tools": [
        "policy.clauses.list",
        "policy.documents.get",
        "policy.library.list"
      ]
    },
    "requests": {
      "description": "Access-request queue with requester, role, duration, justification, attestation, and duplicate links.",
      "tools": [
        "requests.decide",
        "requests.get",
        "requests.queue.list"
      ]
    },
    "resources": {
      "description": "Resource catalog: systems, sensitivity tiers, and segregation-of-duties domains.",
      "tools": [
        "resources.get",
        "resources.search"
      ]
    },
    "reviews": {
      "description": "Approver review-session calendar, windows, and sessions.",
      "tools": [
        "reviews.sessions.create",
        "reviews.sessions.get",
        "reviews.sessions.list",
        "reviews.sessions.update",
        "reviews.windows.list"
      ]
    },
    "screening": {
      "description": "External screening / credentialing vendor confirmations.",
      "tools": [
        "screening.confirmations.get",
        "screening.confirmations.list"
      ]
    },
    "training": {
      "description": "Training and attestation records with completion and expiry dates.",
      "tools": [
        "training.records.get",
        "training.records.list"
      ]
    }
  },
