        "readOnlyHint": false,
        "title": "itsm.changes.create"
      },
      "description": "Raise and schedule a change against a current advisory on a lane window. The lane must be active and certified for the service tier, every window the interval touches must be free, the package must be production-eligible, the downtime must fit the spendable error budget, and a certified secondary must cover the block.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "advisory_id": {
            "type": "string"
          },
          "change_type": {
            "enum": [
              "standard",
              "normal",
              "emergency"
            ],
            "type": "string"
          },
          "downtime_minutes": {
            "minimum": 0,
            "type": "integer"
          },
          "end_time": {
            "description": "ISO local date-time, YYYY-MM-DDTHH:MM:SS",
            "type": "string"
          },
          "lane_id": {
            "type": "string"
          },
          "service_id": {
            "type": "string"
          },
