    {
      "_meta": {
        "hubbench": {
          "hint": "write",
          "server": "hubbench",
          "shape": "benchmark control"
        }
      },
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": false,
        "title": "hubbench.submit_answer"
      },
      "description": "Record the structured decision for the current task. Every field of the task's answer contract is required; resubmission replaces earlier values.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "accelerated_completion": {
            "description": "Outcome date for expedite_arm_package.",
            "type": "string"
          },
          "arm_downtime_minutes": {
            "description": "Planned downtime of the arm pool restart: 1 restart x 6 minutes + 5 validation minutes, tested against the budget.",
            "type": "integer"
          },
          "arm_nodes_superseded_build": {
            "description": "Affected arm nodes whose staged build was cut from the withdrawn revision and cannot deploy.",
            "type": "integer"
          },
          "baseline_completion": {
            "description": "Outcome date for standard_arm_package_first_window.",
            "type": "string"
          },
          "business_need_date": {
            "description": "Documented business or clinical control date that the decision must protect (ISO date).",
            "type": "string"
          },
          "coverage_item_or_resource": {
            "description": "Immutable item or resource whose requirement and eligible coverage were reconciled.",
            "type": "string"
          },
          "decision_timing_status": {
            "description": "ON_TIME when the selected outcome is on or before the control date; otherwise LATE.",
            "enum": [
              "ON_TIME",
              "LATE"
            ],
            "type": "string"
          },
          "earliest_qualified_base_window": {
            "description": "First free LANE-DATA session on or after standard package readiness (ISO date).",
            "type": "string"
          },
          "escalated_completion": {
            "description": "Outcome date for business_hours_change_with_board_exception.",
            "type": "string"
          },
          "escalation_approval_required": {
            "description": "Use 1 when an alternative is outside current authority and would need a separate approval; otherwise 0.",
            "type": "integer"
          },
          "expedite_completion_days_saved": {
            "description": "Days the early-access package saves once the calendar is reapplied.",
            "type": "integer"
          },
          "expedited_external_readiness": {
            "description": "Expedited readiness date independently confirmed for Orrinwave's confirmed standard and early-access arm64 release dates on OWA-2026-052.",
            "type": "string"
          },
          "external_recovery_quantity": {
            "description": "Uncovered NODE that the external recovery must cover.",
            "type": "integer"
          },
          "ineligible_coverage_quantity": {
            "description": "nodes whose staged build was cut from the withdrawn revision",
            "type": "integer"
          },
          "nodes_on_fixed_version": {
            "description": "Nodes already on 12.6.4 from the canary and outside the requirement.",
            "type": "integer"
          },
          "nodes_total": {
            "description": "Active ledger-sync nodes in the CMDB across both pools.",
            "type": "integer"
          },
          "observed_coverage_quantity": {
            "description": "Gross observed coverage for affected nodes holding a staged 12.6.4 build before exclusions.",
            "type": "integer"
          },
          "outcome_vs_control_days": {
            "description": "Selected outcome date minus the documented control date; positive means late.",
            "type": "integer"
          },
          "quantity_unit": {
            "description": "Unit shared by the requirement and coverage calculations: NODE.",
            "type": "string"
          },
          "recommended_incremental_cost_usd": {
            "description": "Documented incremental cost of the selected option in USD; zero when spend is not a decision driver.",
            "type": "integer"
          },
          "recommended_option": {
            "description": "Best authorized option identifier after comparing standard_arm_package_first_window, expedite_arm_package, business_hours_change_with_board_exception.",
            "enum": [
              "standard_arm_package_first_window",
              "expedite_arm_package",
              "business_hours_change_with_board_exception"
            ],
            "type": "string"
          },
          "recommended_outcome_date": {
            "description": "Date produced by the selected option after applying every source constraint (ISO date).",
            "type": "string"
          },
          "required_quantity": {
            "description": "ledger-sync nodes still on an affected orrinwave-db version that OWA-2026-052 must reach",
            "type": "integer"
          },
          "selected_lane_window": {
            "description": "Lane and session used by the selected option, as LANE/YYYY-MM-DD/SESSION.",
            "type": "string"
          },
          "shortage_quantity": {
            "description": "Uncovered NODE after netting eligible coverage from the requirement.",
            "type": "integer"
          },
          "standard_external_readiness": {
            "description": "Standard readiness date independently confirmed for Orrinwave's confirmed standard and early-access arm64 release dates on OWA-2026-052.",
            "type": "string"
          },
          "usable_coverage_quantity": {
            "description": "Net eligible coverage after removing nodes whose staged build was cut from the withdrawn revision.",
            "type": "integer"
          },
          "x86_nodes_validated": {
            "description": "Affected x86 nodes covered by the validated 12.6.4 build.",
            "type": "integer"
          }
        },
        "required": [
          "accelerated_completion",
          "arm_downtime_minutes",
          "arm_nodes_superseded_build",
          "baseline_completion",
          "business_need_date",
          "coverage_item_or_resource",
          "decision_timing_status",
          "earliest_qualified_base_window",
          "escalated_completion",
          "escalation_approval_required",
          "expedite_completion_days_saved",
          "expedited_external_readiness",
          "external_recovery_quantity",
          "ineligible_coverage_quantity",
          "nodes_on_fixed_version",
          "nodes_total",
          "observed_coverage_quantity",
          "outcome_vs_control_days",
          "quantity_unit",
          "recommended_incremental_cost_usd",
          "recommended_option",
          "recommended_outcome_date",
          "required_quantity",
          "selected_lane_window",
          "shortage_quantity",
          "standard_external_readiness",
          "usable_coverage_quantity",
          "x86_nodes_validated"
        ],
        "type": "object"
      },
      "name": "hubbench.submit_answer"
    }
  ]
}
