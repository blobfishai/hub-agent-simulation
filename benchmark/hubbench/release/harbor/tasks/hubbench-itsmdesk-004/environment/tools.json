        "itsm.outages.get",
        "itsm.problems.get",
        "itsm.tasks.create",
        "itsm.tasks.get"
      ]
    },
    "messages": {
      "description": "Service-operations mailbox.",
      "tools": [
        "messages.get",
        "messages.list"
      ]
    },
    "notes": {
      "description": "Stakeholder draft notes (never sent by the benchmark).",
      "tools": [
        "notes.drafts.create"
      ]
    },
    "oncall": {
      "description": "On-call plane: schedules, rostered shifts, escalation policies, responders, and overrides.",
      "tools": [
        "oncall.escalations.get",
        "oncall.overrides.create",
        "oncall.overrides.get",
        "oncall.schedules.list",
        "oncall.shifts.list",
        "oncall.users.get"
      ]
    },
    "telemetry": {
      "description": "Observability: SLO definitions, error-budget views, burn-rate samples, and alert history.",
