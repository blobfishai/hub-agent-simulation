      "additionalProperties": false,
      "properties": {
        "change_request_id": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "end_time": {
          "description": "ISO local date-time, YYYY-MM-DDTHH:MM:SS",
          "type": "string"
        },
        "entry_count": {
          "minimum": 1,
          "type": "integer"
        },
        "lane_id": {
          "type": "string"
        },
        "start_time": {
          "description": "ISO local date-time, YYYY-MM-DDTHH:MM:SS",
          "type": "string"
        }
      },
      "required": [
        "change_request_id",
        "lane_id",
        "start_time",
        "end_time"
      ],
      "type": "object"
    },
